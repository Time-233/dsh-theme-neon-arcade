{
  "name": "dsh-theme-neon-arcade",
  "version": "1.5.1",
  "description": "Neon pixel desktop theme with air battle, Angry Pigs and fruit slicing games, drag controls, gravity and pixel particles.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Time-233/dsh-theme-neon-arcade.git"
  },
  "homepage": "https://github.com/Time-233/dsh-theme-neon-arcade#readme",
  "bugs": { "url": "https://github.com/Time-233/dsh-theme-neon-arcade/issues" },
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "screenshots.json", "src", "scripts", "tests", "assets", "docs", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-package.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "theme", "desktop", "pixel", "neon", "arcade"],
  "engines": { "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
